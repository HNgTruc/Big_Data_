# Copy to infra/.env (git-ignored) and edit.
# Spark image + tag pulled OK on the user's machine (Hadoop 3.4.1 inside). MinIO images come from Chainguard
# because minio/minio (Docker Hub) and quay.io/minio were not pullable on 2026-11-06.
SPARK_IMAGE=apache/spark:4.0.0-python3
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
MC_IMAGE=cgr.dev/chainguard/minio-client:latest

# Local-only credentials for the lab; change them, never reuse real ones.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please
MINIO_BUCKET=bigdata
HADOOP_AWS_VERSION=3.4.1

# Docker/WSL capped at 6 GB: 2 workers x 2g leaves room for the OS, MinIO and the master.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Dữ liệu sinh ra / dữ liệu lớn: không đưa lên git (README của từng thư mục vẫn được giữ)
data/**/*.parquet
data/**/*.csv
data/**/*.json
# manifest.json is small (~2 KB) evidence of injected defects, used to check results/metrics
!data/**/manifest.json
data/**/*.jsonl
data/**/*.crc
# Ivy cache of the spark-submit --packages jars (~1 GB), shared by the --rm driver containers
data/ivy_cache/

# Python
__pycache__/
*.pyc
.venv*/
.pytest_cache/

# Spark event logs of experiments (several MB per run); plan_check.csv keeps the derived evidence
results/logs/**/eventlogs/

# Cấu hình cá nhân của Claude Code
.claude/settings.local.json
.claude/agent-memory-local/
CLAUDE.local.md

# Hệ điều hành / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local secrets/config
.env

# Lecturer slides: local copies for verification only, not redistributed
docs/references/slides/
